# ═══════════════════════════════════════════════════════════════
# AI Agent Configuration
# Copy this file to .env and fill in your values.
# All settings can also be set as environment variables directly.
# ═══════════════════════════════════════════════════════════════

# ── Provider Selection ─────────────────────────────────────────
# Supported: anthropic, openrouter, together, anyscale, deepseek, custom
AI_PROVIDER=anthropic

# ── API Key ────────────────────────────────────────────────────
# Generic key (used for any provider):
# AI_API_KEY=sk-xxx

# Or use provider-specific keys (auto-detected):
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENROUTER_API_KEY=sk-or-xxx
# TOGETHER_API_KEY=xxx
# DEEPSEEK_API_KEY=sk-xxx

# ── Custom Endpoint ────────────────────────────────────────────
# Override the base URL (auto-set per provider, only set for custom endpoints):
# AI_BASE_URL=https://your-custom-api.example.com

# ── Model ──────────────────────────────────────────────────────
# Override the model (auto-set per provider, only set if you want a different one):
# AI_MODEL=claude-sonnet-4-6

# ── Thinking ───────────────────────────────────────────────────
# Set to "false" to disable extended thinking
# AI_THINKING=true

# ── Max Tokens ─────────────────────────────────────────────────
# AI_MAX_TOKENS=64000   # WARNING: 设置过大会显著增加费用（128K ≈ $2-4/call）

# ── Auto Routing ───────────────────────────────────────────────
# Automatically select ReAct vs general agent mode per query (default: true)
# AI_AUTO_ROUTE=true

# ── Router Model ───────────────────────────────────────────────
# Fast/cheap model used by the query router's LLM classifier.
# Defaults to the smallest model for each provider; only set to override.
# AI_ROUTER_MODEL=claude-haiku-4-5

# ── Skills Directory ───────────────────────────────────────────
# Override the skills directory path (default: ./skills)
# AI_SKILLS_DIR=./skills

# ── LLM Wiki ───────────────────────────────────────────────────
# Compiled Markdown knowledge layer. Put source files anywhere, then ingest with:
#   .venv/bin/python wiki_cli.py ingest knowledge_base/inbox
# AI_WIKI_DIR=./knowledge_base/wiki
# AI_WIKI_RAW_DIR=./knowledge_base/raw/sources
# AI_WIKI_GRAPH_DIR=./knowledge_base/graph
#
# RAG fallback corpus. When wiki_search/wiki_read do not find enough context,
# search_documents can still retrieve Wiki-managed raw snapshots and wiki pages.
# AI_RAG_INCLUDE_RAW_SOURCES=true
# AI_RAG_INCLUDE_WIKI=true
# AI_RAG_REFRESH_AFTER_WIKI_INGEST=true

# ── HuggingFace Mirror ───────────────────────────────────────────
# Override the HuggingFace endpoint for downloading embedding models.
# Useful in China where huggingface.co may be inaccessible.
# HF_ENDPOINT=https://hf-mirror.com

# ── Embedding Provider ───────────────────────────────────────────
# "local"  — sentence-transformers (downloads HuggingFace model, default)
# "voyage" — Voyage AI API (no local model, requires VOYAGE_API_KEY)
# "openai" — OpenAI embeddings API (no local model, requires OPENAI_API_KEY)
# AI_EMBEDDING_PROVIDER=local
# VOYAGE_API_KEY=pa-xxx
# AI_VOYAGE_MODEL=voyage-3-lite
# OPENAI_API_KEY=sk-xxx
# AI_OPENAI_MODEL=text-embedding-3-small
#
# 智谱 embedding-3（OpenAI 兼容接口）：
# AI_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=<智谱 API key>
# AI_OPENAI_MODEL=embedding-3
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ── Qdrant Vector Store ──────────────────────────────────────────
# Collection name for the Qdrant local store (stored in knowledge_base/.rag_cache/)
# AI_QDRANT_COLLECTION=knowledge_base

# ── Neo4j GraphRAG ───────────────────────────────────────────────
# Requires: pip install neo4j
# Requires: docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5
# AI_NEO4J_URI=bolt://localhost:7687
# AI_NEO4J_USER=neo4j
# AI_NEO4J_PASSWORD=password
